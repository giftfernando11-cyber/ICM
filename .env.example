# Local SQLite database (created when the backend is run)
DATABASE_URL=sqlite:///./mindia.db

# Frontend API URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# OpenAI (required to enable chat; keep the real key only in your local .env)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cookie signing key (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
AUTH_SECRET_KEY=
# Local-only demo: exposes test OTP codes in the UI; never enable in production
AUTH_DEMO_MODE=false
# Email verification codes (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Optional phone verification codes (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional social login (register each callback URL with the provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/oauth/facebook/callback
FRONTEND_BASE_URL=http://localhost:5173

# ARPQI owner identity (keep private in local .env / deployment variables)
ARPQI_OWNER_EMAIL=
ARPQI_OWNER_PHONE=

# Set to true when serving over HTTPS
AUTH_COOKIE_SECURE=false
